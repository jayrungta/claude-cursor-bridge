# cursor-bridge model-tier configuration
#
# Maps abstract tiers (used by scripts/cursor-dispatch and the prompt
# templates) to concrete `cursor-agent --model` values. Model names drift as
# Cursor ships new ones — edit this file, not the scripts, when they do.
#
# Copy this file to config/models.env and edit there. models.env is
# gitignored; models.example.env stays under version control as the
# documented default.
#
# List currently installed models with: agent --list-models

# Mechanical implementation, cheap fix-loop iterations.
TIER_FAST=composer-2.5

# Default implementation tier: multi-file coordination, integration work.
TIER_STANDARD=composer-2.5

# Reviews, and any task needing the most capable judgment available.
TIER_HIGH=gpt-5.5-high
