#!/usr/bin/env bash
# cursor-dispatch: run one role (implementer|reviewer|fixer) as a cursor-agent
# process instead of a Claude Task-tool subagent. Speaks the same file-handoff
# contract as superpowers' subagent-driven-development: a task brief goes in
# as a file path, a report comes back as a file path, and only a short status
# block (or, for reviewers, the full structured verdict) is printed back to
# the caller. File contents are never pasted into this script's own output.
#
# Usage:
#   cursor-dispatch --role implementer|reviewer|fixer --tier fast|standard|high \
#     --brief <file> [--report <file>] [--diff <file>] [--context "<one-liner>"] \
#     --workdir <repo> --worktree <slug>
#
# implementer/fixer require --report (the file they must write their report
# to). reviewer does not use --report — its reply IS the report, matching the
# convention in task-reviewer-prompt.md. reviewer requires --diff.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
root=$(cd "$here/.." && pwd)

role=""
tier=""
brief=""
report=""
diff=""
context=""
workdir=""
worktree=""

usage() {
  echo "usage: cursor-dispatch --role implementer|reviewer|fixer --tier fast|standard|high --brief <file> [--report <file>] [--diff <file>] [--context <text>] --workdir <repo> --worktree <slug>" >&2
  exit 2
}

while [ $# -gt 0 ]; do
  case "$1" in
    --role) [ $# -ge 2 ] || { echo "missing value for --role" >&2; usage; }; role=$2; shift 2 ;;
    --tier) [ $# -ge 2 ] || { echo "missing value for --tier" >&2; usage; }; tier=$2; shift 2 ;;
    --brief) [ $# -ge 2 ] || { echo "missing value for --brief" >&2; usage; }; brief=$2; shift 2 ;;
    --report) [ $# -ge 2 ] || { echo "missing value for --report" >&2; usage; }; report=$2; shift 2 ;;
    --diff) [ $# -ge 2 ] || { echo "missing value for --diff" >&2; usage; }; diff=$2; shift 2 ;;
    --context) [ $# -ge 2 ] || { echo "missing value for --context" >&2; usage; }; context=$2; shift 2 ;;
    --workdir) [ $# -ge 2 ] || { echo "missing value for --workdir" >&2; usage; }; workdir=$2; shift 2 ;;
    --worktree) [ $# -ge 2 ] || { echo "missing value for --worktree" >&2; usage; }; worktree=$2; shift 2 ;;
    -h|--help) usage ;;
    *) echo "unknown argument: $1" >&2; usage ;;
  esac
done

blocked() {
  # Emit a BLOCKED-shaped response so the controller's existing
  # BLOCKED-handling logic (re-dispatch with more context, escalate, or fall
  # back to a real Claude subagent) applies unchanged, whether the failure
  # came from cursor-agent itself or from a preamble check here.
  echo "Status: BLOCKED"
  echo "Reason: $1"
  exit 0
}

# --- Preamble checks -------------------------------------------------------

case "$role" in
  implementer|reviewer|fixer) ;;
  "") echo "missing --role" >&2; usage ;;
  *) echo "unknown --role: $role (expected implementer|reviewer|fixer)" >&2; usage ;;
esac

[ -n "$tier" ] || { echo "missing --tier" >&2; usage; }
[ -n "$brief" ] || { echo "missing --brief" >&2; usage; }
[ -n "$workdir" ] || { echo "missing --workdir" >&2; usage; }
[ -n "$worktree" ] || { echo "missing --worktree" >&2; usage; }

if [ "$role" != "reviewer" ] && [ -z "$report" ]; then
  echo "missing --report (required for role=$role)" >&2
  usage
fi
if [ "$role" = "reviewer" ] && [ -z "$diff" ]; then
  echo "missing --diff (required for role=reviewer)" >&2
  usage
fi

command -v agent >/dev/null 2>&1 || blocked "cursor-agent CLI not found on PATH (see README install steps)"

if ! agent status >/dev/null 2>&1; then
  blocked "cursor-agent is not logged in (run: agent login)"
fi

if [ ! -f "$brief" ]; then
  blocked "brief file not found: $brief"
fi
if [ "$role" = "reviewer" ] && [ ! -f "$diff" ]; then
  blocked "diff file not found: $diff"
fi
if [ ! -d "$workdir" ]; then
  blocked "workdir not found: $workdir"
fi

is_git_repo=true
if ! git -C "$workdir" rev-parse --show-toplevel >/dev/null 2>&1; then
  is_git_repo=false
fi

if [ "$role" = "reviewer" ] && [ "$is_git_repo" = false ]; then
  blocked "workdir is not a git repository: $workdir (reviewer needs a diff, which requires git; use implementer/fixer for non-git directories)"
fi

# `agent -w` runs the prompt with cwd set to a fresh worktree under
# ~/.cursor/worktrees/, not $workdir -- a relative brief/report/diff path
# would not resolve there. Canonicalize to absolute paths so they resolve
# regardless of which directory the agent process actually runs in.
to_abs() {
  local p=$1 d b
  case "$p" in
    /*) printf '%s\n' "$p"; return ;;
  esac
  d=$(dirname "$p")
  b=$(basename "$p")
  mkdir -p "$d"
  printf '%s/%s\n' "$(cd "$d" && pwd)" "$b"
}

brief=$(to_abs "$brief")
[ -n "$report" ] && report=$(to_abs "$report")
[ -n "$diff" ] && diff=$(to_abs "$diff")
workdir=$(cd "$workdir" && pwd)

model=$("$here/resolve-model" "$tier") || blocked "could not resolve tier '$tier' to a model"

case "$role" in
  reviewer) template_name=task-reviewer ;;
  *) template_name=$role ;;
esac
prompt_template="$root/prompts/$template_name.md"
[ -f "$prompt_template" ] || blocked "no prompt template for role: $role ($prompt_template)"

# --- Worktree args (needed before prompt composition for [WORKDIR]) ---------
# `-w <slug>` always creates a brand-new worktree and errors if that name is
# already taken. A fixer dispatch must continue in the SAME worktree an
# earlier implementer dispatch created, not spin up another one -- so when
# --workdir already points inside a linked worktree (its git-dir differs from
# the repo's common git-dir), run there directly with no -w flag at all.
# When --workdir is the main repo, -w creates the fresh isolated worktree as
# usual (the implementer/reviewer first-dispatch case).
worktree_args=(-w "$worktree")
if [ "$is_git_repo" = true ]; then
  git_dir=$(git -C "$workdir" rev-parse --git-dir)
  common_dir=$(git -C "$workdir" rev-parse --git-common-dir)
  if [ "$git_dir" != "$common_dir" ]; then
    worktree_args=()
  fi
else
  worktree_args=()
fi

if [ "$is_git_repo" = true ] && [ ${#worktree_args[@]} -gt 0 ]; then
  workdir_display="your current working directory (an isolated git worktree created for this task)"
else
  workdir_display="$workdir"
fi

# --- Compose the prompt -----------------------------------------------------
# Substitute file-path placeholders only. Never inline brief/report/diff
# contents here -- that is the whole point of the file-handoff contract.

prompt=$(cat "$prompt_template")
prompt=${prompt//\[BRIEF_FILE\]/$brief}
prompt=${prompt//\[REPORT_FILE\]/${report:-N\/A}}
prompt=${prompt//\[DIFF_FILE\]/${diff:-N\/A}}
prompt=${prompt//\[CONTEXT\]/${context:-none provided}}
prompt=${prompt//\[WORKDIR\]/$workdir_display}

if [ "$is_git_repo" = true ]; then
  isolation_note='You are running inside an isolated git worktree created for this task alone -- that isolation only holds if you operate relative to your own current directory. The brief may contain literal shell commands with an absolute path to the main repository checkout (plans are often written assuming direct, non-isolated execution). Treat any such path as descriptive context, never as a literal `cd` target: do not `cd` to it, and do not run git commands against it. All file paths, edits, tests, and commits happen in your current directory exactly as it stands when you start.'
else
  isolation_note="This directory ($workdir) is not a git repository, so there is no isolated worktree and no branch/commit safety net -- you are working directly on the real files there. Make only the changes the brief calls for. Do not run \`git init\` or any other git command unless the brief explicitly asks you to."
fi
prompt=${prompt//\[ISOLATION_NOTE\]/$isolation_note}

# --- Run ---------------------------------------------------------------
set +e
# macOS ships bash 3.2, which treats "${arr[@]}" on an empty array as an
# unbound variable under `set -u` -- the `+` parameter-expansion form below
# avoids that.
raw=$(cd "$workdir" && agent -p --force --trust --model "$model" \
  ${worktree_args[@]+"${worktree_args[@]}"} \
  --output-format json "$prompt" 2>&1)
status=$?
set -e

if [ $status -ne 0 ]; then
  blocked "cursor-agent exited $status: $(echo "$raw" | tail -c 500)"
fi

# `agent -w` prints a "Using worktree: ..." notice on stdout before the JSON
# result line when it creates a new worktree, so the JSON is not necessarily
# the whole output -- pull out the result line specifically.
json_line=$(echo "$raw" | grep -m1 '^{"type":"result"' || true)
if [ -z "$json_line" ]; then
  blocked "cursor-agent produced no {\"type\":\"result\"...} line: $(echo "$raw" | tail -c 500)"
fi

result=$(echo "$json_line" | python3 -c '
import json, sys
try:
    obj = json.loads(sys.stdin.read())
except Exception as e:
    print("__PARSE_ERROR__: " + str(e))
    sys.exit(0)
if obj.get("is_error"):
    print("__AGENT_ERROR__: " + str(obj.get("result", obj)))
else:
    print(obj.get("result", ""))
')

if [[ "$result" == __PARSE_ERROR__* ]]; then
  blocked "could not parse cursor-agent JSON output: ${result#__PARSE_ERROR__: }"
fi
if [[ "$result" == __AGENT_ERROR__* ]]; then
  blocked "cursor-agent reported an error: ${result#__AGENT_ERROR__: }"
fi

# implementer/reviewer/fixer all reply in the shape their prompt template
# demands (short status block, or for reviewer the full structured verdict).
# Print it verbatim -- this is the only output that reaches the controller.
echo "$result"
